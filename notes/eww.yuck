(defpoll planner :initial "--" :interval "1s" "scripts/planner.sh")

(defwindow planner
           :monitor 1
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "0%"
                               :height "0%"
                               :anchor "center center")
           :stacking "bg"
           :reserve (struts :distance "40px" :side "top")
           :windowtype "desktop"
           :wm-ignore false
  (box :class "planner" :orientation "v" :space-evenly false :spacing 0 planner)
)
